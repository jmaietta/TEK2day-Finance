FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Copy every root Python file rather than naming them. Naming them has broken
# the container twice: seo_pages.py (86ec675, Jun 2026) and partner_api.py
# (Aug 2026). A missing name builds fine and dies on startup.
COPY *.py ./
COPY static/ ./static/
COPY templates/ ./templates/
EXPOSE 8080
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080"]
