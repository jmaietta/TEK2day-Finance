FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Copy every root Python file rather than naming them. A named list has
# shipped a container missing a module three times: seo_pages.py (Jun 2026),
# partner_api.py (Aug 2026), proposals.py (Aug 2026). Each built cleanly and
# died at startup on the import. The extra files are inert - only the
# entrypoint runs.
COPY *.py ./
COPY static/ ./static/
COPY templates/ ./templates/
EXPOSE 8080
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080"]
